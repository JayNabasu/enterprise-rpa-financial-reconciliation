<Activity mc:Ignorable="sap sap2010" x:Class="Process"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_TransactionItem" Type="InArgument(ui:QueueItem)" />
    <x:Property Name="in_Config" Type="InArgument(scg:Dictionary(x:String, x:Object))" />
  </x:Members>
  <sap2010:ExpressionActivityEditor.ExpressionActivityEditor>CSharp</sap2010:ExpressionActivityEditor.ExpressionActivityEditor>
  <sap:VirtualizedContainerService.HintSize>800,900</sap:VirtualizedContainerService.HintSize>
  <sap2010:WorkflowViewState.IdRef>Process_1</sap2010:WorkflowViewState.IdRef>
  <Sequence DisplayName="Process Sequence - Invoice Verification &amp; SAP S/4HANA Posting" sap:VirtualizedContainerService.HintSize="680,850" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="rawInvoiceText" />
      <Variable x:TypeArguments="x:Double" Default="0.0" Name="confidenceScore" />
      <Variable x:TypeArguments="x:String" Name="sapBaseUrl" />
      <Variable x:TypeArguments="x:String" Name="invoiceNumber" />
      <Variable x:TypeArguments="x:String" Name="poNumber" />
      <Variable x:TypeArguments="x:String" Name="tin" />
      <Variable x:TypeArguments="x:Decimal" Name="netAmount" />
      <Variable x:TypeArguments="x:Decimal" Name="vatAmount" />
      <Variable x:TypeArguments="x:Decimal" Name="grossAmount" />
    </Sequence.Variables>
    
    <ui:LogMessage DisplayName="Log Start Process" sap:VirtualizedContainerService.HintSize="450,92" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Beginning automated extraction and 3-way reconciliation for transaction."</CSharpValue>
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>

    <ui:Comment DisplayName="Step 1: High Performance RegEx Extraction" sap:VirtualizedContainerService.HintSize="450,75" 
      Text="// Invoke EnterpriseRPA.RegexEngine.InvoiceRegexParser.Parse(rawInvoiceText) to extract structured fields." />

    <ui:Comment DisplayName="Step 2: AI Fallback Evaluation (UiPath AI / Gemini REST)" sap:VirtualizedContainerService.HintSize="450,95" 
      Text="// If confidenceScore &lt; Convert.ToDouble(in_Config[&quot;ConfidenceThreshold&quot;]), invoke Services\\GeminiAiFallback.xaml." />

    <ui:Comment DisplayName="Step 3: SAP S/4HANA 3-Way Match &amp; Accounting Posting" sap:VirtualizedContainerService.HintSize="450,95" 
      Text="// Send HTTP POST to SAP OData service API_OP_INVOICE_PROCESS_SRV. Handle 422 BusinessRuleException if variance is detected." />

    <ui:LogMessage DisplayName="Log Finish Process" sap:VirtualizedContainerService.HintSize="450,92" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Transaction completed and cleared in SAP S/4HANA."</CSharpValue>
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
  </Sequence>
</Activity>
