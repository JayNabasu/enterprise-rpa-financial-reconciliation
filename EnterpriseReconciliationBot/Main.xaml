<Activity mc:Ignorable="sap sap2010" x:Class="Main"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_OrchestratorQueueName" Type="InArgument(x:String)" />
    <x:Property Name="in_OrchestratorQueueFolder" Type="InArgument(x:String)" />
  </x:Members>
  <sap2010:ExpressionActivityEditor.ExpressionActivityEditor>CSharp</sap2010:ExpressionActivityEditor.ExpressionActivityEditor>
  <sap:VirtualizedContainerService.HintSize>800,800</sap:VirtualizedContainerService.HintSize>
  <sap2010:WorkflowViewState.IdRef>ActivityBuilder_1</sap2010:WorkflowViewState.IdRef>
  <Sequence DisplayName="Main Sequence - REFramework State Machine" sap:VirtualizedContainerService.HintSize="720,700" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="s:Exception" Name="SystemException" />
      <Variable x:TypeArguments="ui:BusinessRuleException" Name="BusinessException" />
      <Variable x:TypeArguments="ui:QueueItem" Name="TransactionItem" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Object)" Name="Config" />
      <Variable x:TypeArguments="x:Int32" Default="1" Name="TransactionNumber" />
    </Sequence.Variables>
    <StateMachine InitialState="{x:Reference __ReferenceID2}" DisplayName="General Business Process - State Machine" sap:VirtualizedContainerService.HintSize="680,620" sap2010:WorkflowViewState.IdRef="StateMachine_1">
      <!-- 1. Init State -->
      <State x:Name="__ReferenceID2" DisplayName="Initialization State" sap:VirtualizedContainerService.HintSize="180,70" sap2010:WorkflowViewState.IdRef="State_1">
        <State.Entry>
          <Sequence DisplayName="Init Sequence" sap:VirtualizedContainerService.HintSize="380,250" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ui:LogMessage DisplayName="Log Init Message" sap:VirtualizedContainerService.HintSize="334,92" Level="Info">
              <ui:LogMessage.Message>
                <InArgument x:TypeArguments="x:Object">
                  <CSharpValue x:TypeArguments="x:Object">"Initializing applications and reading enterprise configuration..."</CSharpValue>
                </InArgument>
              </ui:LogMessage.Message>
            </ui:LogMessage>
            <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" DisplayName="Invoke InitAllSettings" sap:VirtualizedContainerService.HintSize="334,112" UnSafe="False" WorkflowFileName="Framework\\InitAllSettings.xaml">
              <ui:InvokeWorkflowFile.Arguments>
                <InArgument x:TypeArguments="x:String" x:Key="in_ConfigFile">Data\\Config.xlsx</InArgument>
                <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="out_Config">
                  <CSharpReference x:TypeArguments="scg:Dictionary(x:String, x:Object)">Config</CSharpReference>
                </OutArgument>
              </ui:InvokeWorkflowFile.Arguments>
            </ui:InvokeWorkflowFile>
          </Sequence>
        </State.Entry>
        <State.Transitions>
          <Transition DisplayName="Success - Go to Get Transaction" sap2010:WorkflowViewState.IdRef="Transition_1">
            <Transition.Condition>
              <CSharpValue x:TypeArguments="x:Boolean">SystemException == null</CSharpValue>
            </Transition.Condition>
            <Transition.To>
              <State x:Name="__ReferenceID0" DisplayName="Get Transaction Data" sap:VirtualizedContainerService.HintSize="180,70" sap2010:WorkflowViewState.IdRef="State_2">
                <State.Entry>
                  <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" DisplayName="Invoke GetTransactionData" sap:VirtualizedContainerService.HintSize="334,112" UnSafe="False" WorkflowFileName="Framework\\GetTransactionData.xaml">
                    <ui:InvokeWorkflowFile.Arguments>
                      <InArgument x:TypeArguments="x:Int32" x:Key="in_TransactionNumber">
                        <CSharpValue x:TypeArguments="x:Int32">TransactionNumber</CSharpValue>
                      </InArgument>
                      <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">
                        <CSharpValue x:TypeArguments="scg:Dictionary(x:String, x:Object)">Config</CSharpValue>
                      </InArgument>
                      <OutArgument x:TypeArguments="ui:QueueItem" x:Key="out_TransactionItem">
                        <CSharpReference x:TypeArguments="ui:QueueItem">TransactionItem</CSharpReference>
                      </OutArgument>
                    </ui:InvokeWorkflowFile.Arguments>
                  </ui:InvokeWorkflowFile>
                </State.Entry>
                <State.Transitions>
                  <Transition DisplayName="New Transaction" sap2010:WorkflowViewState.IdRef="Transition_2">
                    <Transition.Condition>
                      <CSharpValue x:TypeArguments="x:Boolean">TransactionItem != null</CSharpValue>
                    </Transition.Condition>
                    <Transition.To>
                      <State x:Name="__ReferenceID1" DisplayName="Process Transaction" sap:VirtualizedContainerService.HintSize="180,70" sap2010:WorkflowViewState.IdRef="State_3">
                        <State.Entry>
                          <ui:InvokeWorkflowFile ContinueOnError="{x:Null}" DisplayName="Invoke Process Workflow" sap:VirtualizedContainerService.HintSize="334,112" UnSafe="False" WorkflowFileName="Process.xaml">
                            <ui:InvokeWorkflowFile.Arguments>
                              <InArgument x:TypeArguments="ui:QueueItem" x:Key="in_TransactionItem">
                                <CSharpValue x:TypeArguments="ui:QueueItem">TransactionItem</CSharpValue>
                              </InArgument>
                              <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">
                                <CSharpValue x:TypeArguments="scg:Dictionary(x:String, x:Object)">Config</CSharpValue>
                              </InArgument>
                            </ui:InvokeWorkflowFile.Arguments>
                          </ui:InvokeWorkflowFile>
                        </State.Entry>
                        <State.Transitions>
                          <Transition DisplayName="Processed - Next Item" sap2010:WorkflowViewState.IdRef="Transition_3" To="{x:Reference __ReferenceID0}">
                            <Transition.Action>
                              <Assign DisplayName="Increment Transaction Number" sap:VirtualizedContainerService.HintSize="262,60">
                                <Assign.To>
                                  <OutArgument x:TypeArguments="x:Int32">
                                    <CSharpReference x:TypeArguments="x:Int32">TransactionNumber</CSharpReference>
                                  </OutArgument>
                                </Assign.To>
                                <Assign.Value>
                                  <InArgument x:TypeArguments="x:Int32">
                                    <CSharpValue x:TypeArguments="x:Int32">TransactionNumber + 1</CSharpValue>
                                  </InArgument>
                                </Assign.Value>
                              </Assign>
                            </Transition.Action>
                            <Transition.Condition>
                              <CSharpValue x:TypeArguments="x:Boolean">SystemException == null &amp;&amp; BusinessException == null</CSharpValue>
                            </Transition.Condition>
                          </Transition>
                        </State.Transitions>
                      </State>
                    </Transition.To>
                  </Transition>
                </State.Transitions>
              </State>
            </Transition.To>
          </Transition>
        </State.Transitions>
      </State>
      <x:Reference>__ReferenceID0</x:Reference>
      <x:Reference>__ReferenceID1</x:Reference>
    </StateMachine>
  </Sequence>
</Activity>
